# Throwaway loopback development credentials. Never use these for shared data.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql+psycopg://sec450:local-development-only@127.0.0.1:55432/sec450
TEST_DATABASE_URL=postgresql+psycopg://sec450:local-development-only@127.0.0.1:55432/sec450_test

# Optional isolated course-system storage. An absent value in local mode uses
# disposable SQLite, never DATABASE_URL or TEST_DATABASE_URL implicitly.
# COURSE_TEST_DATABASE_URL=postgresql+psycopg://sec450:local-development-only@127.0.0.1:55432/sec450_test
# COURSE_TEST_ALLOW_SHARED_DATABASE=0
# Public delivery requires an explicit COURSE_TEST_DATABASE_URL. A shared
# physical database additionally requires the trusted opt-in above set to 1.

# Optional manual Team 102 access. Set a real key only in ignored local secrets.
SEC450_KEY=
